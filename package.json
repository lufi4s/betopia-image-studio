    "start": "node server/index.js",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "cookie": "^2.0.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "astro": "^7.3.8"
  }
}
