{
  "name": "betopia-image-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Text-to-image generation platform (Astro UI + Express API) powered by Betopia Cloud",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch --watch-path=server server/index.js",
    "astro": "astro dev",
