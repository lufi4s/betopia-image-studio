<section class="gallery shell">
  <div class="gallery-head">
    <div>
      <span class="eyebrow">Output</span>
      <h2>Gallery</h2>
      <p class="count" id="gallerySub">Every image generated on this platform.</p>
    </div>
    <input class="search" id="search" type="search" placeholder="Search prompts…" />
  </div>

  <div class="grid" id="grid"></div>

  <div class="empty" id="empty">
    <h3>No images yet</h3>
    <p>Write a prompt above and hit <strong>Generate</strong> — your creations will appear here.</p>
    <div class="ideas" id="promptIdeas"></div>
  </div>

  <div class="load-more" id="loadMoreWrap" hidden>
    <button class="secondary-btn" id="loadMoreBtn" type="button">Load more</button>
  </div>
</section>
