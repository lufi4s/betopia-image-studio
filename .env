# Committed defaults — NEVER put BETOPIA_API_KEY in this file, the repo is public.
#   local key  → .env.local   (gitignored, read after .env so it wins)
#   deploy key → Netlify: Site configuration → Environment variables

BETOPIA_BASE_URL=https://models.betopiacloud.com/image/v1
BETOPIA_MODEL=qwen-image-2.1-turbo

# One port for everything: UI + API + generated images.
PORT=4321
GENERATION_TIMEOUT_MS=180000
